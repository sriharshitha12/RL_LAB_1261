        "#Assignment 1: Calculate State Value and Action Value\n",
        "# Grid World - 2 x 3\n",
        "# Using discounted return (without Bellman Equation)"
      ],
      "metadata": {
        "id": "oCx3TUkvRXU-"
      }
    },
    {
      "cell_type": "code",
      "execution_count": 1,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "0cRrx3pjRC_7",
        "outputId": "c1515ebc-0895-4375-ab2c-ecb35efe5025"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "STATE VALUE\n",
            "-------------------------\n",
            "Path: S0 -> S1 -> S3 -> S4 -> G\n",
            "Rewards: [-1, -1, -1, 10]\n",
            "Discounted Return: 4.580000000000001\n",
            "\n",
            "ACTION VALUE\n",
            "-------------------------\n",
            "\n",
            "Action: Up\n",
            "Path: S0 -> S0 -> S1 -> S3 -> S4 -> G\n",
            "Rewards: [-1, -1, -1, -1, 10]\n",
            "Action Value Q(S0, Up): 3.122\n"
          ]
        }
      ],
      "source": [
        "\n",
        "\n",
        "# Discount factor\n",
        "gamma = 0.9\n",
        "\n",
        "# Rewards\n",
        "normal_reward = -1\n",
        "goal_reward = 10\n",
        "\n",
        "# Policy\n",
        "policy = {\n",
        "    \"S0\": \"Right\",\n",
        "    \"S1\": \"Down\",\n",
        "    \"S3\": \"Right\",\n",
        "    \"S4\": \"Up\"\n",
        "}\n",
        "\n",
        "# Grid:\n",
        "# S0  S1  G\n",
        "# X   S3  S4\n",
        "\n",
        "# Function to calculate state value using the path\n",
        "def state_value_function(start_state):\n",
        "    path = []\n",
        "    rewards = []\n",
        "\n",
        "    state = start_state\n",
        "\n",
        "    while state != \"G\":\n",
        "\n",
        "        path.append(state)\n",
        "\n",
        "        # Follow the given policy\n",
        "        action = policy[state]\n",
        "\n",
        "        # State transitions\n",
        "        if state == \"S0\" and action == \"Right\":\n",
        "            next_state = \"S1\"\n",
        "            reward = normal_reward\n",
        "\n",
        "        elif state == \"S1\" and action == \"Down\":\n",
        "            next_state = \"S3\"\n",
        "            reward = normal_reward\n",
        "\n",
        "        elif state == \"S3\" and action == \"Right\":\n",
        "            next_state = \"S4\"\n",
        "            reward = normal_reward\n",
        "\n",
        "        elif state == \"S4\" and action == \"Up\":\n",
        "            next_state = \"G\"\n",
        "            reward = goal_reward\n",
        "\n",
        "        rewards.append(reward)\n",
        "        state = next_state\n",
        "\n",
        "    path.append(\"G\")\n",
        "\n",
        "    # Calculate discounted return\n",
        "    value = 0\n",
        "\n",
        "    for i in range(len(rewards)):\n",
        "        value += (gamma ** i) * rewards[i]\n",
        "\n",
        "    print(\"Path:\", \" -> \".join(path))\n",
        "    print(\"Rewards:\", rewards)\n",
        "    print(\"Discounted Return:\", value)\n",
        "\n",
        "    return value\n",
        "\n",
        "\n",
        "# Function to calculate action value\n",
        "def action_value_function(state, action):\n",
        "\n",
        "    rewards = []\n",
        "    path = [state]\n",
        "\n",
        "    # First action is given by the question\n",
        "    if state == \"S0\" and action == \"Up\":\n",
        "\n",
        "        # Up from S0 is outside the grid.\n",
        "        # Agent stays in S0.\n",
        "        rewards.append(normal_reward)\n",
        "        next_state = \"S0\"\n",
        "\n",
        "        path.append(\"S0\")\n",
        "\n",
        "    else:\n",
        "        print(\"This example is for S0 and Up.\")\n",
        "        return\n",
        "\n",
        "    # After the first action, follow the policy\n",
        "    while next_state != \"G\":\n",
        "\n",
        "        state = next_state\n",
        "        policy_action = policy[state]\n",
        "\n",
        "        if state == \"S0\" and policy_action == \"Right\":\n",
        "            next_state = \"S1\"\n",
        "            reward = normal_reward\n",
        "\n",
        "        elif state == \"S1\" and policy_action == \"Down\":\n",
        "            next_state = \"S3\"\n",
        "            reward = normal_reward\n",
        "\n",
        "        elif state == \"S3\" and policy_action == \"Right\":\n",
        "            next_state = \"S4\"\n",
        "            reward = normal_reward\n",
        "\n",
        "        elif state == \"S4\" and policy_action == \"Up\":\n",
        "            next_state = \"G\"\n",
        "            reward = goal_reward\n",
        "\n",
        "        rewards.append(reward)\n",
        "        path.append(next_state)\n",
        "\n",
        "    # Calculate discounted return\n",
        "    value = 0\n",
        "\n",
        "    for i in range(len(rewards)):\n",
        "        value += (gamma ** i) * rewards[i]\n",
        "\n",
        "    print(\"\\nAction:\", action)\n",
        "    print(\"Path:\", \" -> \".join(path))\n",
        "    print(\"Rewards:\", rewards)\n",
        "    print(\"Action Value Q(S0, Up):\", value)\n",
        "\n",
        "    return value\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Calculate State Value for S0\n",
        "# --------------------------------------------------\n",
        "\n",
        "print(\"STATE VALUE\")\n",
        "print(\"-------------------------\")\n",
        "\n",
        "V_S0 = state_value_function(\"S0\")\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Calculate Action Value for S0 and Up\n",
        "# --------------------------------------------------\n",
        "\n",
        "print(\"\\nACTION VALUE\")\n",
        "print(\"-------------------------\")\n",
        "\n",
        "Q_S0_Up = action_value_function(\"S0\", \"Up\")"
      ]
    }
  ]
